        {
          "query": "import \"date\"\r\nimport \"strings\"\r\n\r\nselectedYear = \"${anio}\"\r\nselectedProv = \"${provincia}\"\r\n\r\nyearIsAll = strings.containsStr(v: selectedYear, substr: \",\") \r\n            or selectedYear == \"*\" \r\n            or selectedYear == \"$__all\"\r\n\r\nprovIsAll = selectedProv == \"$__all\" \r\n            or selectedProv == \"All\" \r\n            or selectedProv == \"\"\r\n\r\nstart = if yearIsAll then 1996-01-01T00:00:00Z\r\n        else time(v: selectedYear + \"-01-01T00:00:00Z\")\r\n\r\nstop  = if yearIsAll then now()\r\n        else time(v: selectedYear + \"-12-31T23:59:59Z\")\r\n\r\nbase = from(bucket: \"poblacion_municipios\")\r\n  |> range(start: start, stop: stop)\r\n  |> filter(fn: (r) => r._measurement == \"ine_stats\"\r\n                    and r.subgrupo == \"municipios\"\r\n                    and r.sexo == \"Total\"\r\n                    and r._field == \"valor\")\r\n\r\nfiltered = if provIsAll then\r\n              base\r\n           else\r\n              base |> filter(fn: (r) => contains(value: r.provincia, set: [${provincia:doublequote}]))\r\n\r\nfiltered\r\n  |> last()\r\n  |> keep(columns: [\"municipio\", \"_value\"])\r\n  |> group()\r\n  |> sort(columns: [\"_value\"], desc: true)\r\n  |> limit(n: 5)",
          "refId": "A"
        }
      ],
