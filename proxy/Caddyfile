# Proxy inverso de Poview: única puerta de entrada, TLS para todo.
#
#   https://localhost/        -> frontend (Vite)        app:3000
#   https://localhost/api/*   -> backend (FastAPI)      backend:8000
#
# `tls internal` hace que Caddy genere su propia CA local y firme un
# certificado para "localhost" automáticamente: no necesitas aportar
# ficheros .crt/.key. La primera vez el navegador avisará de que la CA no
# es de confianza; para quitar el aviso, confía en la CA raíz de Caddy
# (instrucciones en el README/notas) o sustituye `tls internal` por
# `tls /certs/localhost.pem /certs/localhost-key.pem` con certificados de
# mkcert montados en /certs.

localhost {
    encode gzip

    # API -> backend FastAPI (incluye WebSocket si lo añades en el futuro)
    handle /api/* {
        reverse_proxy backend:8000
    }

    # Todo lo demás -> frontend Vite (incluye el WebSocket de HMR en dev)
    handle {
        reverse_proxy app:3000
    }

    tls internal
}
